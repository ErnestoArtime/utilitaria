POSTGRES_DB=utilitaria
POSTGRES_USER=utilitaria
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://utilitaria:change-me@db:5432/utilitaria
OPENWA_BASE_URL=http://openwa-api:2785
OPENWA_TOKEN=
OPENWA_SESSION_ID=
TIENDASOLAR_BASE_URL=
TIENDASOLAR_TOKEN=
ELTOQUE_PAGE_URL=https://eltoque.com/tasas-de-cambio-cuba
ELTOQUE_CACHE_MINUTES=15
ELTOQUE_API_URL=https://tasas.eltoque.com/v1/trmi
# Opcional: API oficial de elTOQUE como respaldo cuando el scraping sea bloqueado.
ELTOQUE_API_KEY=
API_KEY=change-me
ALLOW_LEGACY_API_KEY=false
ADMIN_ENROLLMENT_CODE=change-me-admin
MEMBER_ENROLLMENT_CODE=change-me-member
CAPTURE_ENROLLMENT_CODE=change-me-capture
SERVICE_API_TOKEN=change-me-service-token
S3_BACKUP_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_BACKUP_BUCKET=utilitaria-backups
S3_BACKUP_PREFIX=utilitaria/postgres
S3_BACKUP_ACCESS_KEY_ID=
S3_BACKUP_SECRET_ACCESS_KEY=
S3_BACKUP_REGION=auto
GONIOGAS_PRODUCT_URL=https://goniogas.com/producto/cilindro-de-gas-de-10kg/
ALERT_CHECK_INTERVAL_SECONDS=300
# El servicio API monta una cuenta de servicio y la expone en esta ruta.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-admin.json
